// 해당코드는 Codex로 수정됨
#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_integer_dot_product : require

// Each uint16_t input stores two signed INT8 values:
//   bits  0..7  -> low
//   bits 8..15  -> high
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer16 {
    uint16_t packedInt16Data[];
};

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer32 {
    int resultData[];
};

layout(push_constant, std430) uniform DispatchInfo {
    uint elementCount;
} dispatchInfo;

int decodeSignedByte(uint bits) {
    // Convert the low byte to [-128, 127] without relying on an
    // out-of-range uint -> int8_t conversion.
    uint byteValue = bits & 0xffu;
    return int(byteValue ^ 0x80u) - 128;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= dispatchInfo.elementCount) {
        return;
    }

    // GL_EXT_shader_16bit_storage only permits load/store and conversion for
    // uint16_t here. Promote to uint before shifting or masking.
    uint packed = uint(packedInt16Data[idx]);
    int low = decodeSignedByte(packed);
    int high = decodeSignedByte(packed >> 8u);

    // Preserve the PDF's expression exactly:
    //   low * high + low + high
    //
    // dotEXT(i8vec2, i8vec2) maps to OpSDotKHR instead of relying on a
    // compiler to recognize scalar INT32 arithmetic as an INT8 dot product.
    i8vec2 lhs = i8vec2(ivec2(low, high));
    i8vec2 rhs = i8vec2(ivec2(high, 1));
    resultData[idx] = dotEXT(lhs, rhs) + low;
}
